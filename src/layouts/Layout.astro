---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="Portfolio de Lautaro Casella - Software Engineer & Game Developer"
        />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    </head>
    <body class="bg-carbon text-bone font-sans antialiased min-h-screen">
        <Navbar />
        <slot />
    </body>
</html>
