---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const educationES = [
    {
        degree: "Licenciatura en Programación de Videojuegos y Simulaciones",
        institution: "Universidad Nacional de Hurlingham (UNAHUR)",
        date: "2024 - Presente",
        status: "En curso",
    },
    {
        degree: "Tecnicatura Universitaria en Informática",
        institution: "Universidad Nacional de Hurlingham (UNAHUR)",
        date: "2018 - 2023",
        status: "Finalizada",
    },
];

const educationEN = [
    {
        degree: "Bachelor's Degree in Video Game Programming and Simulations",
        institution: "Universidad Nacional de Hurlingham (UNAHUR)",
        date: "2024 - Present",
        status: "In progress",
    },
    {
        degree: "University Technician in Computer Science",
        institution: "Universidad Nacional de Hurlingham (UNAHUR)",
        date: "2018 - 2023",
        status: "Completed",
    },
];

// Seleccionamos el array correcto según el idioma
const education = lang === "es" ? educationES : educationEN;

// Lógica local para la sección extra
const extras = {
    title: lang === "es" ? "Idiomas & Complementos" : "Languages & Extras",
    description:
        lang === "es"
            ? "Habilidades adicionales que complementan mi perfil técnico."
            : "Additional skills that complement my technical profile.",
    badges:
        lang === "es"
            ? ["Inglés B2 (Intermedio-Alto)", "Metodologías Ágiles (Scrum)"]
            : [
                  "English B2 (Upper-Intermediate)",
                  "Agile Methodologies (Scrum)",
              ],
};
---

<section id="educacion" class="mb-32 scroll-mt-20">
    <h3 class="text-3xl font-bold mb-10 flex items-center gap-3 text-bone">
        <span class="text-accent font-mono text-xl">03.</span>
        {t("nav.education")}
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        {
            education.map((item) => (
                <div class="bg-carbon border border-gray-800 p-6 rounded-lg hover:border-gray-600 transition-colors">
                    <div class="flex justify-between items-start mb-4">
                        <span class="bg-surface text-accent font-mono text-xs px-2 py-1 rounded border border-gray-700">
                            {item.status}
                        </span>
                        <span class="text-gray-500 font-mono text-sm">
                            {item.date}
                        </span>
                    </div>
                    <h4 class="text-xl font-bold text-bone mb-2">
                        {item.degree}
                    </h4>
                    <p class="text-gray-400">{item.institution}</p>
                </div>
            ))
        }
    </div>

    <!-- Sección extra para Idiomas y Certificaciones clave -->
    <div
        class="bg-surface border border-gray-800 p-6 rounded-lg flex flex-col md:flex-row md:items-center justify-between gap-4"
    >
        <div>
            <h4 class="text-lg font-bold text-bone mb-1">
                {extras.title}
            </h4>
            <p class="text-gray-400 text-sm">
                {extras.description}
            </p>
        </div>
        <div class="flex flex-wrap gap-3">
            {
                extras.badges.map((badge) => (
                    <span class="text-sm font-mono text-bone bg-carbon px-3 py-1.5 rounded border border-gray-700">
                        {badge}
                    </span>
                ))
            }
        </div>
    </div>
</section>
