---
const jobs = [
  {
    title: "Desarrollador Fullstack",
    company: "Municipalidad de San Martín",
    date: "08/2023 - Actualidad",
    description: [
        "Liderazgo técnico en la modernización, desarrollo y mantenimiento del ecosistema 'Boleta Digital' para la gestión de tasas municipales.",
        "Modernización del modelo de identidad digital mediante integración segura con APIs de organismos oficiales (AFIP, ANSES, RENAPER).",
        "Diseño y optimización de Stored Procedures en SQL Server.",
        "Desarrollo de un dashboard de gestión con control de acceso basado en roles y reportes dinámicos exportables.",
        "Implementación de encriptación de datos sensibles y validación robusta por tokens."
    ],
    tech: ["C#", ".NET Framework 4.8", "SQL Server", "ASP.NET WebForms", "APIs"]
  },
  {
    title: "Desarrollador Fullstack",
    company: "Municipalidad de Hurlingham",
    date: "10/2021 - 12/2022",
    description: [
        "Desarrollo integral de sistemas internos para el control de inventario y gestión operativa de personal.",
        "Construcción del frontend y backend utilizando Angular, TypeScript y bases de datos relacionales SQL.",
        "Desarrollo de un sistema de verificación de cuentas mediante confirmación por correo electrónico, implementando validación con códigos de seguridad y diseñando una interfaz de usuario estilo OTP.",
        "Participación en el ciclo de vida del desarrollo aplicando metodologías ágiles SCRUM."
    ],
    tech: ["Angular", "TypeScript", "SQL"]
  }
];
---

<section id="experiencia" class="mb-32 scroll-mt-20">
    <h3 class="text-3xl font-bold mb-10 flex items-center gap-3 text-bone">
        <span class="text-accent font-mono text-xl">02.</span> Experiencia Profesional
    </h3>

    <!-- Contenedor de la línea de tiempo -->
    <div class="relative border-l border-gray-700 ml-3 space-y-12">
        {jobs.map((job) => (
            <div class="pl-8 relative group">
                <!-- Punto en la línea de tiempo -->
                <span class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-surface border-2 border-accent group-hover:bg-accent transition-colors"></span>
                
                <!-- Encabezado del puesto -->
                <div class="flex flex-col md:flex-row md:items-center justify-between mb-2">
                    <h4 class="text-2xl font-bold text-bone">
                        {job.title} <span class="text-accent">@ {job.company}</span>
                    </h4>
                    <span class="font-mono text-sm text-gray-400 mt-1 md:mt-0">{job.date}</span>
                </div>
                
                <!-- Descripción en viñetas -->
                <ul class="list-disc marker:text-accent pl-5 space-y-2 text-gray-400 leading-relaxed mb-4 max-w-3xl">
                    {job.description.map((bullet) => (
                        <li>{bullet}</li>
                    ))}
                </ul>
                
                <!-- Etiquetas de tecnología -->
                <div class="flex flex-wrap gap-2">
                    {job.tech.map((tech) => (
                        <span class="text-xs font-mono text-gray-300 bg-surface px-2 py-1 rounded border border-gray-800">
                            {tech}
                        </span>
                    ))}
                </div>
            </div>
        ))}
    </div>
</section>