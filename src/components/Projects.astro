---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sectionTitle = lang === 'es' ? "Proyectos Destacados" : "Featured Projects";

const proyectosES = [
  {
    title: "Into the Unknown",
    image: "./depths_gameplay.gif",
    description: "Roguelike 2D de acción. Arquitectura basada en eventos (Observer) para desacoplar combate y UI, e implementación de IA con Steering Behaviors para múltiples tipos de enemigos.",
    tags: ["Unity", "C#", "Observer Pattern", "IA"],
    linkItch: "https://kezgan.itch.io/into-the-unknown",
    linkGithub: "https://github.com/lmcasella/roguelike-game"
  },
  {
    title: "Star Attack",
    image: "./starattack_gameplay.gif",
    description: "Shoot 'em up 2D con progresión por oleadas. Diseño modular de armamento aplicando el patrón Strategy mediante Scriptable Objects y gestión estricta de memoria (Game Loop).",
    tags: ["Unity", "C#", "Strategy Pattern", "Scriptable Objects"],
    linkItch: "https://kezgan.itch.io/star-attack",
    linkGithub: "https://github.com/lmcasella/star-attack"
  },
  {
    title: "Cyber Survivors",
    image: "./cybersurvivors_gameplay.gif",
    description: "Bullet-heaven enfocado en rendimiento web. Implementación desde cero de un algoritmo de Spatial Hashing para detección de colisiones masivas a 60 FPS sin caídas.",
    tags: ["Pixi.js", "JavaScript", "Spatial Hashing", "State Machine"],
    linkItch: "https://kezgan.itch.io/cyber-survivors",
    linkGithub: "https://github.com/lmcasella/cyber-survivors"
  },
  {
    title: "Portal Datos: API & Worker",
    image: "./portal-datos.jpg",
    description: "Sistema Fullstack bajo Clean Architecture. Implementación de un Background Worker en .NET 9 para procesamiento asíncrono de lotes de pago, seguridad JWT y acceso a datos optimizado con Dapper y SQL Server.",
    tags: [".NET 9", "React", "Dapper", "Background Worker"],
    linkItch: "", 
    linkGithub: "https://github.com/lmcasella/portal-datos"
  }
];

const proyectosEN = [
  {
    title: "Into the Unknown",
    image: "./depths_gameplay.gif",
    description: "2D top-down action roguelike. Event-based architecture (Observer pattern) to decouple combat and UI, and AI implementation with Steering Behaviors for multiple enemy types.",
    tags: ["Unity", "C#", "Observer Pattern", "AI"],
    linkItch: "https://kezgan.itch.io/into-the-unknown",
    linkGithub: "https://github.com/lmcasella/roguelike-game"
  },
  {
    title: "Star Attack",
    image: "./starattack_gameplay.gif",
    description: "2D wave-based shoot 'em up. Modular weapon design applying the Strategy pattern via Scriptable Objects, and strict memory management preventing leaks.",
    tags: ["Unity", "C#", "Strategy Pattern", "Scriptable Objects"],
    linkItch: "https://kezgan.itch.io/star-attack",
    linkGithub: "https://github.com/lmcasella/star-attack"
  },
  {
    title: "Cyber Survivors",
    image: "./cybersurvivors_gameplay.gif",
    description: "Web-performance focused bullet-heaven. From-scratch implementation of a Spatial Hashing algorithm for massive collision detection at 60 FPS without drops.",
    tags: ["Pixi.js", "JavaScript", "Spatial Hashing", "State Machine"],
    linkItch: "https://kezgan.itch.io/cyber-survivors",
    linkGithub: "https://github.com/lmcasella/cyber-survivors"
  },
  {
    title: "Portal Datos: API & Worker",
    image: "./portal-datos.jpg",
    description: "Full stack system built under Clean Architecture. Implementation of a .NET 9 Background Worker for asynchronous payment batch processing, JWT security, and optimized data access with Dapper and SQL Server.",
    tags: [".NET 9", "React", "Dapper", "Background Worker"],
    linkItch: "", 
    linkGithub: "https://github.com/lmcasella/portal-datos"
  }
];

const proyectos = lang === 'es' ? proyectosES : proyectosEN;
---

<section id="proyectos" class="mb-32 scroll-mt-20">
    <h3 class="text-3xl font-bold mb-10 flex items-center gap-3 text-bone">
        <span class="text-accent font-mono text-xl">01.</span> {sectionTitle}
    </h3>

    <!-- Grilla (Ahora se acomoda sola para 4 elementos: 2 filas de 2 en pantallas grandes) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {proyectos.map((proyecto) => (
            <div class="bg-surface rounded-xl border border-gray-800 hover:border-accent transition-all overflow-hidden flex flex-col h-full group hover:shadow-[0_0_20px_rgba(16,185,129,0.15)]">
                
                <!-- Imagen del proyecto -->
                <div class="w-full aspect-video bg-carbon overflow-hidden border-b border-gray-800 relative">
                    <img 
                        src={`${import.meta.env.BASE_URL}${proyecto.image.replace('./', '/')}`} 
                        alt={`Preview de ${proyecto.title}`} 
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                </div>

                <!-- Contenido de la tarjeta -->
                <div class="p-6 flex flex-col grow">
                    <h4 class="text-2xl font-bold text-bone mb-3">{proyecto.title}</h4>
                    <p class="text-gray-400 mb-6 grow text-sm leading-relaxed">
                        {proyecto.description}
                    </p>
                    
                    <!-- Etiquetas (Tags) -->
                    <div class="flex flex-wrap gap-2 mb-6 mt-auto">
                        {proyecto.tags.map((tag) => (
                            <span class="text-xs font-mono text-accent bg-accent/10 px-2 py-1 rounded border border-accent/20">
                                {tag}
                            </span>
                        ))}
                    </div>

                    <!-- Botones Ghost -->
                    <div class="flex gap-3 border-t border-gray-800 pt-4">
                        {proyecto.linkItch && (
                            <a href={proyecto.linkItch} target="_blank" class="px-4 py-2 text-sm font-medium text-bone border border-gray-700 rounded hover:border-accent hover:text-accent hover:bg-accent/10 transition-all flex items-center gap-2">
                                Itch.io ↗
                            </a>
                        )}
                        {proyecto.linkGithub && (
                            <a href={proyecto.linkGithub} target="_blank" class="px-4 py-2 text-sm font-medium text-bone border border-gray-700 rounded hover:border-accent hover:text-accent hover:bg-accent/10 transition-all flex items-center gap-2">
                                {t('ui.code')}
                            </a>
                        )}
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>