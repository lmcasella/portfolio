---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const email = "lautaromcasella@gmail.com";
const linkedin = "https://www.linkedin.com/in/lautaro-casella-b990a6216/";
const github = "https://github.com/lmcasella";
const itch = "https://kezgan.itch.io/";
---

<footer id="contacto" class="border-t border-gray-800 bg-surface mt-20">
    <div
        class="max-w-5xl mx-auto px-6 py-16 flex flex-col md:flex-row justify-between items-center md:items-start gap-8"
    >
        <!-- Llamado a la acción -->
        <div class="text-center md:text-left">
            <h3 class="text-2xl font-bold text-bone mb-2">
                {t("footer.title")}
            </h3>
            <p class="text-gray-400 mb-6 max-w-sm">
                {t("footer.desc")}
            </p>
            <!-- Formulario de Contacto -->
            <div class="w-full max-w-md mt-8 md:mt-0">
                <form
                    action="https://formspree.io/f/xqppqjad"
                    method="POST"
                    class="flex flex-col gap-4"
                >
                    <input
                        type="text"
                        name="name"
                        required
                        placeholder={t("footer.name")}
                        class="w-full bg-carbon border border-gray-800 rounded px-4 py-3 text-bone focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all"
                    />
                    <input
                        type="email"
                        name="email"
                        required
                        placeholder={t("footer.email")}
                        class="w-full bg-carbon border border-gray-800 rounded px-4 py-3 text-bone focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all"
                    />
                    <textarea
                        name="message"
                        required
                        rows="4"
                        placeholder={t("footer.msg")}
                        class="w-full bg-carbon border border-gray-800 rounded px-4 py-3 text-bone focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all resize-none"
                    ></textarea>
                    <button
                        type="submit"
                        class="bg-accent hover:bg-[#059669] text-carbon font-bold px-6 py-3 rounded transition-all shadow-[0_0_15px_rgba(16,185,129,0.3)] hover:shadow-[0_0_25px_rgba(16,185,129,0.6)] mt-2"
                    >
                        {t("footer.send")}
                    </button>
                </form>
            </div>
        </div>

        <!-- Enlaces -->
        <div class="flex flex-col items-center md:items-end gap-4">
            <h4 class="font-mono text-accent text-sm uppercase tracking-widest">
                {t("footer.links")}
            </h4>
            <div class="flex gap-6">
                <a
                    href={linkedin}
                    target="_blank"
                    class="text-gray-400 hover:text-accent transition-colors font-medium"
                >
                    LinkedIn
                </a>
                <a
                    href={github}
                    target="_blank"
                    class="text-gray-400 hover:text-accent transition-colors font-medium"
                >
                    GitHub
                </a>
                <a
                    href={itch}
                    target="_blank"
                    class="text-gray-400 hover:text-accent transition-colors font-medium"
                >
                    Itch.io
                </a>
            </div>
        </div>
    </div>

    <!-- Copyright / Créditos -->
    <div class="border-t border-gray-800">
        <div
            class="max-w-5xl mx-auto px-6 py-6 flex flex-col md:flex-row justify-between items-center gap-4"
        >
            <p class="text-gray-500 text-sm">
                © {new Date().getFullYear()} Lautaro Casella. {
                    t("footer.rights")
                }
            </p>
            <p class="text-gray-600 font-mono text-xs">
                {t("footer.built")}
            </p>
        </div>
    </div>
</footer>
